# Copy this file to .env and fill in real values. Never commit .env itself.
#
# Everything below has a working default for local development except
# SECRET_KEY and DB_PASSWORD. The only variables a production deployment
# *must* change are marked.

# --- Core -------------------------------------------------------------------
# REQUIRED in production. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# Running with DEBUG=False and the built-in default refuses to start.
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database ---------------------------------------------------------------
DB_NAME=soullog_dev
DB_USER=soullog
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
# Most managed hosts hand you a single URL instead; when set, it wins over
# the DB_* values above.
# DATABASE_URL=postgres://user:password@host:5432/dbname
# Connection reuse, in seconds. 0 (the default) opens a new connection per
# request, which is right behind a pgbouncer and wasteful without one.
DB_CONN_MAX_AGE=0

# --- Real-time (Whispers, live notifications) -------------------------------
# Leave REDIS_URL empty for local development: the in-memory channel layer
# is used and no Redis is needed. It is REQUIRED as soon as the backend
# runs more than one worker process — without it, a message delivered by
# one worker never reaches a socket held by another.
REDIS_URL=

# How long after their last request someone still counts as "active now".
PRESENCE_ACTIVE_WINDOW_SECONDS=300

# --- CORS / hosts -----------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Defaults to CORS_ALLOWED_ORIGINS when unset.
# CSRF_TRUSTED_ORIGINS=
FRONTEND_BASE_URL=http://localhost:5173
TIME_ZONE=UTC

# --- Media storage ----------------------------------------------------------
# Local disk by default. Setting USE_S3=True moves every upload — journal
# photos and voice notes, Sanctuary media, message attachments, avatars —
# to an S3-compatible bucket with no code change.
USE_S3=False
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_REGION_NAME=
# For Cloudflare R2, Backblaze B2, MinIO or DigitalOcean Spaces:
# AWS_S3_ENDPOINT_URL=
# AWS_S3_CUSTOM_DOMAIN=
# Journal media is personal data, so objects are private and URLs are
# signed and expiring by default. Only turn this off for a bucket holding
# nothing private.
# AWS_QUERYSTRING_AUTH=True
# AWS_QUERYSTRING_EXPIRE=3600

# Upload size limits, in megabytes. Enforced server-side.
MAX_IMAGE_UPLOAD_MB=10
MAX_AUDIO_UPLOAD_MB=25
MAX_VIDEO_UPLOAD_MB=200

# --- Email ------------------------------------------------------------------
# The console backend prints emails (password resets) to the server log
# instead of sending them, which is what local development wants. Setting
# EMAIL_HOST switches to real SMTP automatically.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@soullog.local
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True

# --- Rate limits ------------------------------------------------------------
# Applied to the endpoints that can be hit without an account.
THROTTLE_AUTH=20/min
THROTTLE_PASSWORD_RESET=5/min
THROTTLE_UPLOAD=60/hour
THROTTLE_SEARCH=60/min

# --- Operations -------------------------------------------------------------
LOG_LEVEL=INFO
# Entirely opt-in: with no DSN, nothing is imported and nothing is sent.
# Error reports never include request bodies or user PII — journal entries
# are the most private data here and must not leave in a stack trace.
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.1

# Only read when DEBUG=False.
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
