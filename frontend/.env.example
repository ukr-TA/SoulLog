# Copy to .env for local development.
#
# Vite inlines these at build time, so changing one means rebuilding —
# they are not read at runtime.

VITE_API_BASE_URL=http://localhost:8000/api/v1

# The WebSocket URL is derived from VITE_API_BASE_URL (http -> ws, with
# the /api/v1 suffix stripped), so there is no second variable here to
# drift out of step with the first. See `socketUrl` in src/api.ts.
